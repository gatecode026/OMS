# ─── SERVER CONFIGURATION ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── DATABASE CONFIGURATION (FUTURE INTEGRATION) ──────────────────────────────
# Replace with actual MongoDB connection string when deploying
DB_URI=mongodb://localhost:27017/office_management_db

# ─── SECURITY & SECRETS ───────────────────────────────────────────────────────
# Replace with a robust custom secure key for JWT tokens
JWT_SECRET=super_secret_jwt_sign_key_office_management_2026
JWT_EXPIRES_IN=7d

# ─── CLIENT CONNECTION ────────────────────────────────────────────────────────
# Origin allowed by CORS settings
CLIENT_URL=http://localhost:5173
