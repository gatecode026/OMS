# ─── FRONTEND ENVIRONMENT VARIABLES (example) ────────────────────────────────
# Copy to `.env` and adjust. Injected by Vite at build time (VITE_ prefix required).

# Backend HTTP + Socket.IO origin
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# ─── Chat architecture (OPRD-WEB-CHAT-001A) ──────────────────────────────────
# Gates the hardened chat layer (Phase B: normalized cache + socket dispatcher)
# on top of the React Query base. Default: true.
# Set to false for an instant rollback to the simple RQ array-cache path.
VITE_CHAT_REACT_QUERY_ENABLED=true
