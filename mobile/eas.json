{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development"
      }
    },
    "qa": {
      "distribution": "internal",
      "channel": "qa",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "qa"
      }
    },
    "uat": {
      "distribution": "internal",
      "channel": "uat",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "uat"
      }
    },
    "staging": {
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "staging"
      }
    },
    "demo": {
      "distribution": "internal",
      "channel": "demo",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "demo"
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
